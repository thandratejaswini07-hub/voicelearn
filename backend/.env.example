# Copy this file to .env and fill in your actual keys
# Never share your actual .env file

# Get free key from https://aistudio.google.com
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Get free key from https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Flask settings
FLASK_ENV=development
FLASK_SECRET_KEY=change_this_to_any_random_string
PORT=5000
